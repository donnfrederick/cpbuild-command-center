# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# Prisma Studio — always use npm scripts (never bare npx prisma studio):
#   npm run db:studio:kill    — stop Studio on :5555 / :5556 / :5557
#   npm run db:studio:check   — hosts for local / dev / prod
#   npm run db:studio         → :5555  .env (local Supabase — same as npm run dev)
#   npm run db:studio:dev     → :5556  .env.dev.local (Railway dev DATABASE_PUBLIC_URL)
#   npm run db:studio:prod    → :5557  .env.prod.local (Railway prod DATABASE_PUBLIC_URL)
#   npm run db:studio:all     — start all three
# Stale Studio without --url can show the wrong DB. See DEV_NOTES.md → Prisma Studio.
#
# Local database: Docker — npm run dev:up (or dev:db) → npm run dev:setup → npm run dev.
# Cloud database: comment Docker lines below and paste Supabase URIs from the dashboard.
# Supabase-only guide: docs/DEV_SETUP_LIGHTWEIGHT.md

# ── Database (Docker — docker-compose.yml) ─────────────────────────────────────
POSTGRES_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/commandcenter"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/commandcenter"

# Optional: Mailpit for email (http://localhost:8025) instead of Resend
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# EMAIL_FROM="Command Center <noreply@commandcenter.local>"

# ── Database (Supabase — use instead of Docker) ───────────────────────────────
# DATABASE_URL="<transaction pooler :6543 + ?pgbouncer=true>"
# DIRECT_URL="<direct db.<project>.supabase.co :5432>"

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3002"
# Required for Auth.js on deploy (Railway, etc.). Keep this in your local
# `.env` as well when running `next dev` after copying from `.env.example`.
AUTH_TRUST_HOST="true"

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Supabase dev uses Resend instead of Mailpit.
# 1. Create a free account at resend.com
# 2. Get an API key from resend.com/api-keys
# 3. Add your personal email as a verified contact so you can receive invite emails locally
#
RESEND_API_KEY="re_YOUR_RESEND_DEV_KEY"
EMAIL_FROM="Command Center <onboarding@resend.dev>"
#
# All outbound emails go to this address in non-production environments.
# Set to your personal email so invite emails land in your inbox during dev.
DEV_EMAIL_OVERRIDE="yourname@gmail.com"
#
# Leave SMTP_HOST unset (or commented out) — when unset the app uses Resend.
# SMTP_HOST=
# SMTP_PORT=

# ── Bootstrap admin ────────────────────────────────────────────────────────────
# Used by npm run dev:setup:cloud to create the first admin account.
# Change these after first login.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"

# Email address that receives new feedback report notifications.
# Defaults to BOOTSTRAP_ADMIN_EMAIL if not set.
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# ── Dev auth bypass ────────────────────────────────────────────────────────────
# Set to "true" to skip the login page entirely during local development.
# Hard-blocked in production — safe to leave enabled locally.
DEV_BYPASS_AUTH="true"

# Map bypass session to a real DB user (recommended). Fixes feedback assignee / “My items”,
# @mentions, and account header vs Users table. Must match an existing User.email locally.
# DEV_BYPASS_USER_EMAIL="you@cpbuild.com"

# ── Oracle Primavera Unifier ───────────────────────────────────────────────────
# Set UNIFIER_MOCK="true" for local dev — skips real Unifier API calls.
UNIFIER_MOCK="true"
UNIFIER_BASE_URL="https://us2.unifier.oraclecloud.com/cpbuild"
UNIFIER_USERNAME="Coadmin"
UNIFIER_PASSWORD="replace-with-unifier-integration-password"
#
# Azure Key Vault (production only — leave commented out in local dev):
# AZURE_KEYVAULT_URL="https://CPBBI-vault1.vault.azure.net/"
# AZURE_CLIENT_ID="..."
# AZURE_CLIENT_SECRET="..."
# AZURE_TENANT_ID="..."

# ── Gemini API (optional) ──────────────────────────────────────────────────────
# Required for Daily Digest, DevTools AI analysis, AI project insights, and the
# optional AI-assisted feedback drafting flow. That flow has two entry points —
# text (POST /api/feedback/assist) and video (POST /api/feedback/assist/video,
# which uploads the user's screen recording through the Gemini Files API and
# seeds the chat with an AI-generated first turn grounded in the video). When
# this key is absent, AI-backed features gracefully disable — e.g. the Feedback
# modal shows the "AI is unavailable" hint and the Analyze-with-AI button is
# disabled. Get a key at aistudio.google.com.
GEMINI_API_KEY=""

# ── Google Geocoding API (optional — field media capture metadata) ─────────────
# Server-only. Geocodes Unifier project siteLocation → lat/lng (cached in
# project_site_geocodes). Powers distance-from-project on photo watermarks and
# CaptureMetadataPanel. NOT the same key as GEMINI_API_KEY (AI Studio).
#
# Setup (one-time):
#   1. console.cloud.google.com → pick/create a project
#   2. APIs & Services → Library → enable "Geocoding API"
#   3. APIs & Services → Credentials → Create credentials → API key
#   4. (Recommended) Edit key → Application restrictions: None for local dev;
#      API restrictions → Restrict key → Geocoding API only
#   5. Paste the key below and restart the dev server (npm run dev:restart)
#
# Without this key locally: GPS/device/capture method still save; distance lines
# and "X ft from project" watermark text are omitted until the key is set.
# GOOGLE_GEOCODING_API_KEY=""

# ── GitHub Token (required for Daily Digest) ───────────────────────────────────
# The Daily Digest pulls your merged PRs and commits to feed into Gemini.
# Without this, Gemini has no real GitHub context and will hallucinate PR data.
#
# To create a token:
#   1. Go to github.com/settings/tokens/new
#   2. Token name: "Command Center Daily Digest"
#   3. Expiration: 90 days (or No expiration)
#   4. Scopes: check "repo" (read access to private repos)
#   5. Click Generate token, copy it here
#
# Also add this to your Railway dev environment variable: GITHUB_TOKEN
# GITHUB_TOKEN="ghp_your_token_here"

# ── DevTools ──────────────────────────────────────────────────────────────────
# Enables the /devtools panel for admin users in non-production environments.
# Leave as "dev" for local development.
APP_ENV="dev"

# ── Supabase Storage ─────────────────────────────────────────────────────────
# Service role key from Supabase dashboard → Project Settings → API → service_role.
# Used server-side for Storage API (signed URLs, uploads).
#
# If unset or empty: POST /api/upload/field-media and POST /api/feedback/upload-screenshot
# store files under .local-field-media/ (or LOCAL_FIELD_MEDIA_ROOT) and serve them via
# GET /api/upload/field-media/file — no Supabase. Screen recordings still need this key.
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
#
# Optional override for local field-media directory (defaults to .local-field-media in project root):
# LOCAL_FIELD_MEDIA_ROOT="/absolute/path/to/uploads"

# ── Automation secret (release tour CI pipeline) ───────────────────────────────
# Used by the GitHub Actions deploy workflow to call POST /api/automation/release-tour
# after each Railway deploy, so AI-generated release tours are created automatically.
# Generate with: openssl rand -base64 32
# Also set in Railway (dev + prod) and as a GitHub Actions secret (AUTOMATION_SECRET).
# AUTOMATION_SECRET="replace-with-a-secure-random-string"

# ── Feedback inbox merge (dev app pulls production feedback) ───────────────────
# Set on Railway DEV only: prod base URL + shared secret. Prod must have the same secret
# and FEEDBACK_BRIDGE_ACTOR_USER_ID (a real prod User cuid for bridge-authored comments).
# Never use NEXT_PUBLIC_* for the secret.
# FEEDBACK_BRIDGE_SECRET="openssl rand -base64 32"
# FEEDBACK_BRIDGE_PROD_BASE_URL="https://command-center-reboot-production.up.railway.app"
# FEEDBACK_BRIDGE_ACTOR_USER_ID="cuid-of-prod-user-for-bridge-comments"

# ── Rad-Dash integration (send selected feedback to Rad-Dash as tickets) ────────
# Set both vars to enable the "Send to Rad-Dash" button in the feedback inbox.
#RAD_DASH_WEBHOOK_SECRET="secret"
#RAD_DASH_WEBHOOK_URL="https://rad-dash.example.com/webhooks/tickets"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Docker alternative (optional — skip this if using Supabase above)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# If you prefer to run Postgres + Mailpit locally via Docker:
#
#   1. Start containers:   npm run dev:up
#   2. Run setup:          npm run dev:setup
#   3. Start app:          npm run dev
#
# Then swap in these values (comment out the Supabase vars above first):
#
# POSTGRES_PORT=5433
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/commandcenter?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/commandcenter?schema=public"
# NEXTAUTH_URL="http://localhost:3002"
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# EMAIL_FROM="Command Center <noreply@commandcenter.local>"
# DEV_EMAIL_OVERRIDE=   ← leave unset; Mailpit catches all outbound email
#                         view emails at http://localhost:8025
