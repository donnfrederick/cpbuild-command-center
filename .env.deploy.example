# Deploy-time configuration for the promote pipeline and verify:dev.
# Copy to .env.deploy and fill in your values.
# This file is gitignored — never commit real URLs or tokens.

# Railway deployment URLs
# Find them in Railway dashboard → your service → Settings → Networking.
RAILWAY_DEV_URL="https://your-service-name-dev.up.railway.app"
RAILWAY_PROD_URL="https://command-center-reboot-production.up.railway.app"

# E2E test account (optional — for authenticated E2E in verify:dev)
# Bootstrap once per env: E2E_TEST_EMAIL=... E2E_TEST_PASSWORD=... DATABASE_URL=... npm run bootstrap:e2e-user
# E2E_TEST_EMAIL="e2e-test@yourdomain.com"
# E2E_TEST_PASSWORD="YourSecureE2EPassword!"
