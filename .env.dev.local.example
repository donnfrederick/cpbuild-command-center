# Railway dev Postgres — Prisma Studio port 5556 only (npm run db:studio:dev).
# Gitignored copy: cp .env.dev.local.example .env.dev.local
#
# Get DATABASE_PUBLIC_URL from Railway (not internal DATABASE_URL):
#   railway variables -s Postgres --json   # with CLI linked to dev environment
#   or Railway dashboard → dev → Postgres → Connect → Public network
#
# npm run db:studio:check   — refs/hosts for :5555 / :5556 / :5557
# npm run db:studio:all     — start all three Studio instances

DATABASE_URL="postgresql://postgres:[PASSWORD]@[host].proxy.rlwy.net:[port]/railway"
