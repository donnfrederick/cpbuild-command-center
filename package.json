{
  "name": "command-center-reboot",
  "version": "1.0.78",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate && npm run check:dev",
    "dev": "rm -rf .next/cache/webpack && NEXTAUTH_URL=http://localhost:3002 DEV_BYPASS_AUTH=true next dev --port 3002 --webpack",
    "dev:kill": "bash scripts/dev-server-daemon.sh stop",
    "dev:start": "bash scripts/dev-server-daemon.sh start",
    "dev:status": "bash scripts/dev-server-daemon.sh status",
    "dev:restart": "bash scripts/dev-server-daemon.sh restart",
    "dev:tunnel": "rm -rf .next/cache/webpack && (bash scripts/ensure-tunnel.sh &) && (bash scripts/tunnel-watch.sh &) && next dev --port 3002 --webpack",
    "dev:guarded": "concurrently --names \"server,guardian\" --prefix-colors \"cyan,yellow\" \"npm run dev\" \"bash scripts/dev-guardian.sh\"",
    "dev:guardian": "bash scripts/dev-guardian.sh",
    "dev:offline": "bash scripts/dev-offline.sh",
    "dev:with-sync": "bash scripts/dev-with-sync.sh",
    "dev:install-sync": "bash scripts/install-dev-sync-agent.sh",
    "dev:turbo": "next dev --port 3002",
    "tunnel": "ngrok http 3002",
    "tunnel:bg": "pkill -f 'ngrok http' 2>/dev/null; sleep 1; nohup ngrok http 3002 > /tmp/ngrok.log 2>&1 & sleep 8 && npm run tunnel:check",
    "tunnel:check": "curl -sf http://localhost:4040/api/tunnels | python3 -c \"import sys,json; t=json.load(sys.stdin)['tunnels']; [print(x['public_url']) for x in t]\" && echo 'tunnel OK' || echo 'NO ACTIVE TUNNEL — run npm run tunnel:bg'",
    "tunnel:restart": "pkill -f 'ngrok http' 2>/dev/null; sleep 1; nohup ngrok http 3002 > /tmp/ngrok.log 2>&1 & sleep 8 && npm run tunnel:check",
    "build": "next build --webpack",
    "build:start": "npm run build && PORT=3002 npm start",
    "prestart": "node scripts/pdf-next-bundle-guard.cjs",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --open",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "bash scripts/prisma-migrate-dev.sh",
    "db:push": "prisma db push",
    "db:studio": "bash scripts/prisma-studio-local.sh",
    "db:studio:dev": "bash scripts/prisma-studio-dev.sh",
    "db:studio:prod": "bash scripts/prisma-studio-prod.sh",
    "db:studio:both": "bash scripts/prisma-studio-both.sh",
    "db:studio:all": "bash scripts/prisma-studio-all.sh",
    "db:studio:kill": "bash scripts/prisma-studio-kill.sh",
    "db:studio:check": "bash scripts/db-studio-check-env.sh",
    "db:studio:prove": "bash scripts/db-studio-prove.sh",
    "db:generate": "prisma generate",
    "db:deploy": "bash scripts/prisma-migrate-deploy.sh",
    "bootstrap:roles": "tsx scripts/bootstrap-roles.ts",
    "bootstrap:permissions": "tsx scripts/bootstrap-permissions.ts",
    "bootstrap:role-permissions": "tsx scripts/bootstrap-role-permissions.ts",
    "grant:special-permission": "tsx scripts/grant-special-permission.ts",
    "bootstrap:inspection-types": "tsx scripts/bootstrap-inspection-types.ts",
    "bootstrap:issue-catalog": "tsx scripts/bootstrap-issue-catalog.ts",
    "bootstrap:observation-catalog": "tsx scripts/bootstrap-observation-catalog.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "bootstrap:user": "tsx scripts/bootstrap-user.ts",
    "bootstrap:e2e-user": "tsx scripts/bootstrap-e2e-user.ts",
    "bootstrap:bi-reader-grants": "tsx scripts/bootstrap-bi-reader-grants.ts",
    "bootstrap:app-announcements": "tsx scripts/bootstrap-app-announcements.ts",
    "bootstrap:test-media": "tsx scripts/bootstrap-test-media.ts",
    "field-daily:scheduled": "tsx scripts/run-field-daily-scheduled.ts",
    "promote": "tsx scripts/promote.ts",
    "verify:dev": "tsx scripts/verify-dev.ts",
    "smoke:pdf-browser": "tsx scripts/smoke-pdf-browser.ts",
    "verify:prod": "tsx scripts/verify-prod.ts",
    "verify:prod:open": "tsx scripts/verify-prod.ts --open",
    "verify:prod:quick": "tsx scripts/verify-prod.ts --skip-tests --open",
    "check:prod": "curl -sf https://command-center-reboot-production.up.railway.app/api/health && echo '\\n✅ Prod is healthy' || echo '\\n❌ Prod health check FAILED'",
    "check:dev": "tsx scripts/check-dev-updates.ts",
    "verify:i18n": "node scripts/verify-units-i18n.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "BASE_URL=http://localhost:3002 playwright test",
    "test:e2e:headed": "playwright test --headed --slowMo=600",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:smoke": "playwright test e2e/smoke.spec.ts --reporter=list",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "dev:setup:cloud": "tsx scripts/dev-setup-cloud.ts",
    "dev:up": "docker compose up -d",
    "dev:db": "docker compose up -d postgres",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "dev:mail": "open http://localhost:8025",
    "sync:prototype": "bash scripts/sync-prototype.sh",
    "seed:projects": "echo 'Seed removed — projects are created via Unifier integration'",
    "seed:inspections": "tsx scripts/seed-inspection-data.ts",
    "seed:inspections:reset": "tsx scripts/seed-inspection-data.ts --reset",
    "seed:inspections:clear": "tsx scripts/seed-inspection-data.ts --reset-only",
    "backfill:inspection-deficiencies": "tsx scripts/backfill-inspection-deficiencies.ts",
    "backfill:inspection-deficiencies:dry-run": "tsx scripts/backfill-inspection-deficiencies.ts --dry-run",
    "backfill:inspection-reporting": "tsx scripts/backfill-inspection-deficiencies.ts",
    "backfill:inspection-reporting:dry-run": "tsx scripts/backfill-inspection-deficiencies.ts --dry-run",
    "verify:inspection-reporting-backfill": "tsx scripts/verify-inspection-reporting-backfill.ts",
    "cleanup:empty-rows": "tsx scripts/cleanup-empty-project-rows.ts",
    "cleanup:empty-rows:execute": "tsx scripts/cleanup-empty-project-rows.ts --execute",
    "unifier:check": "tsx scripts/unifier-check.ts",
    "refresh:learnings": "bash scripts/refresh-learnings.sh",
    "bot-pr:rerun-ci": "tsx scripts/rerun-blocked-bot-ci.ts",
    "pr:rerun-blocked-ci": "tsx scripts/rerun-blocked-bot-ci.ts",
    "pr:status": "gh pr list --state open --json number,title,headRefName,statusCheckRollup,reviews --jq '.[] | { pr: .number, title: .title, branch: .headRefName, ci: ([.statusCheckRollup[] | select(.conclusion != \"SUCCESS\" and .conclusion != \"NEUTRAL\") | .name] | if length == 0 then \"✅ all green\" else \"❌ failing: \" + join(\", \") end), copilot: ([.reviews[] | select(.author.login | test(\"copilot\"))] | if length > 0 then \"✅ reviewed\" else \"⏳ pending\" end) }'"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sparticuz/chromium-min": "^147.0.2",
    "@swc/helpers": "0.5.23",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "heic2any": "^0.0.4",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.6",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "puppeteer-core": "^24.43.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "resend": "^6.19.0",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "workbox-webpack-plugin": "^7.4.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "msw": "^2.15.0",
    "process": "^0.11.10",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ajv": "^6.14.0",
    "hono": "^4.12.7",
    "@hono/node-server": "^1.19.10",
    "serialize-javascript": "^7.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
