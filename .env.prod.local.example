# Production database — Prisma Studio port 5557 only (npm run db:studio:prod).
# Gitignored copy: cp .env.prod.local.example .env.prod.local
#
# MUST be a different Supabase project than DATABASE_URL in .env (commandcenter-prod vs local dev).
#
# Get the URI from either:
#   Railway → command-center-reboot → production → Variables → DATABASE_URL
#   Supabase → commandcenter-prod → Settings → Database → Connection string (URI)
#
# npm run db:studio:check  — prints project refs for :5555 vs :5557 without secrets
# npm run db:studio:both   — start local + prod Studio at the same time
#
# Local migrate guard: npm run db:deploy / db:migrate refuse targets matching this file.
# Intentional prod migrate from laptop (Phil only): ALLOW_PROD_MIGRATE=1 npm run db:deploy

DATABASE_URL="postgresql://postgres.[PROD-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROD-REF].supabase.co:5432/postgres"
