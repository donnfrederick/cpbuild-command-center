# Environment parity: consistent installs across developers and CI
# Suppresses ERESOLVE peer dependency warnings (e.g. nodemailer @auth/core)
legacy-peer-deps=true

# Do not fail hard on transitive dependency engine mismatches.
# npm ci already uses exact versions from the lockfile — engine-strict
# adds no safety benefit and breaks builds when a transitive dep bumps
# its engines field beyond the version pinned in the Railway nixpkgs snapshot.
engine-strict=false
